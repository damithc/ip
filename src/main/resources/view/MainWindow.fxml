<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="520.0" minWidth="620.0"
            prefHeight="680.0" prefWidth="820.0"
            stylesheets="@../css/main.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="duke.ui.MainWindow">
    <children>
        <VBox styleClass="workspace-header"
              spacing="2.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <Label styleClass="workspace-title" text="Damien" />
            <Label styleClass="workspace-subtitle" text="Task assistant for focused work" />
        </VBox>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="ALWAYS"
                    vvalue="1.0"
                    AnchorPane.bottomAnchor="82.0"
                    AnchorPane.leftAnchor="0.0"
                    AnchorPane.rightAnchor="0.0"
                    AnchorPane.topAnchor="78.0">
            <content>
                <VBox fx:id="dialogContainer"
                      fillWidth="true"
                      prefHeight="552.0"
                      prefWidth="388.0" />
            </content>
        </ScrollPane>
        <HBox alignment="CENTER_LEFT"
              spacing="10.0"
              styleClass="command-bar"
              AnchorPane.bottomAnchor="16.0"
              AnchorPane.leftAnchor="24.0"
              AnchorPane.rightAnchor="24.0">
            <TextField fx:id="userInput"
                       onAction="#handleUserInput"
                       prefHeight="46.0"
                       promptText="Type a task command..."
                       HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton"
                    mnemonicParsing="false"
                    onAction="#handleUserInput"
                    prefHeight="46.0"
                    prefWidth="104.0"
                    text="Send" />
        </HBox>
    </children>
</AnchorPane>
